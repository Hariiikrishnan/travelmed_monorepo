datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  password              String
  name                  String
  role                  String   @default("user")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  freeConsultationCount Int      @default(0)
  orders                Order[]

  @@map("users")
}

model Medicine {
  id               String            @id
  name             String
  category         String // legacy display name — kept in sync with medicineCategory.name
  categoryId       String?
  medicineCategory MedicineCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description      String
  activeIngredient String
  dosage           String
  warning          String
  sideEffects      String
  fdaStatus        String
  travelNote       String
  compartment      String
  alternative      String
  symptoms         String[]
  kitItems         KitItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([categoryId])
  @@map("medicines")
}

model MedicineCategory {
  id        String     @id @default(uuid())
  slug      String     @unique
  name      String     @unique
  icon      String     @default("")
  sortOrder Int        @default(0)
  medicines Medicine[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("medicine_categories")
}

model KitType {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String    @unique
  description String    @default("")
  sortOrder   Int       @default(0)
  status      String    @default("Active") // Active, Inactive
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("kit_types")
}

/// One medicine inside a kit, with how much of it the kit contains.
model KitItem {
  id         String   @id @default(uuid())
  productId  String
  medicineId String
  quantity   Int      @default(1)
  unit       String   @default("pcs")
  note       String   @default("")
  sortOrder  Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([productId, medicineId])
  @@index([medicineId])
  @@map("kit_items")
}

model Doctor {
  id                String                @id
  name              String
  specialty         String
  languages         String[]
  experience        String
  bio               String
  rating            Float
  reviewsCount      Int
  availability      String
  image             String
  videoSimulatedUrl String
  qualification     String                @default("")
  status            String                @default("Active") // Active, Inactive
  fees              Int?
  days              String[]              @default([])
  slots             String[]              @default([])
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  consultations     ConsultationBooking[]

  @@map("doctors")
}

model TravelScenario {
  id            String   @id
  title         String
  description   String
  riskLevel     String
  region        String
  medicinesList String[]
  instructions  String
  icon          String
  image         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("travel_scenarios")
}

model Testimonial {
  id        String   @id
  name      String
  location  String
  tripType  String
  quote     String
  rating    Float
  avatar    String
  status    String   @default("Pending") // Pending, Approved, Rejected
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

model Order {
  orderId           String                @id
  userId            String?
  user              User?                 @relation(fields: [userId], references: [id])
  status            String                @default("Pending") // Pending, Processing, Shipped, Out for Delivery, Delivered, Cancelled, Refunded
  trackingNumber    String
  estimatedDelivery String
  subtotal          Float
  shippingCost      Float
  total             Float
  shippingFullName  String
  shippingAddress   String
  shippingCity      String
  shippingCountry   String
  shippingZipCode   String
  shippingPhone     String?
  shippingEmail     String?
  couponCode        String?
  discount          Float                 @default(0)
  paymentStatus     String                @default("Pending") // Pending, Paid, Failed
  paymentId         String?
  razorpayOrderId   String?               @unique
  consultsAllowed   Int                   @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  items             OrderItem[]
  consultations     ConsultationBooking[]

  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  productId      String?
  name           String
  price          Float
  quantity       Int
  type           String // kit, addon
  description    String?
  sizeOption     String? // Solo, Couple, Family
  pediatricAddon Boolean @default(false)
  seniorAddon    Boolean @default(false)
  order          Order   @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@map("order_items")
}

model Coupon {
  id        String   @id @default(uuid())
  code      String   @unique
  discount  Int
  type      String   @default("Percentage") // Percentage, Fixed
  usages    Int      @default(0)
  status    String   @default("Active") // Active, Inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coupons")
}

model SupportTicket {
  id        String   @id @default(uuid())
  user      String
  subject   String
  message   String
  status    String   @default("Open") // Open, Solved
  priority  String   @default("Medium") // High, Medium, Low
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("support_tickets")
}

model ActivityLog {
  id        String   @id @default(uuid())
  user      String   @default("System Admin")
  action    String
  changes   String
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

model Product {
  id               String    @id
  slug             String    @unique
  name             String
  sku              String    @unique
  mrp              Float
  price            Float
  gstPercent       Float     @default(5)
  stock            Int       @default(0)
  status           String    @default("In Stock") // In Stock, Out of Stock
  visibility       String    @default("Visible") // Visible, Hidden
  description      String    @default("")
  highlights       String[]  @default([])
  benefits         String[]  @default([])
  specs            Json      @default("{}")
  faqs             Json      @default("[]")
  images           String[]  @default([])
  seoTitle         String    @default("")
  seoDescription   String    @default("")
  kitTypeId        String?
  kitType          KitType?  @relation(fields: [kitTypeId], references: [id], onDelete: SetNull)
  tagline          String    @default("")
  tripLength       String    @default("")
  bagSize          String    @default("")
  bagWeight        String    @default("")
  consultsIncluded Int       @default(0)
  isFeatured       Boolean   @default(false)
  sortOrder        Int       @default(0)
  items            KitItem[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("products")
}

model ConsultationBooking {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  whatsapp    String
  symptom     String
  destination String
  doctorId    String?
  doctor      Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  status      String   @default("New") // New, Contacted, Completed, Cancelled
  meetingLink String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@map("consultation_bookings")
}
