PORT=5000

# PostgreSQL Connection URL
# Replace username, password, localhost, port, and database_name with your values
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travelmed?schema=public"

# JWT Secret for Admin Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Frontend Origin for CORS configuration
FRONTEND_URL="http://localhost:3000"

# Razorpay Payment Gateway Credentials
# Replace "dummy" with your real Razorpay Key ID and Secret in production
RAZORPAY_KEY_ID="dummy"
RAZORPAY_KEY_SECRET="dummy"


# Admin account created by `npm run prisma:seed` (password min 12 chars). Never commit real values.
ADMIN_EMAIL="admin@travelmed.org"
ADMIN_PASSWORD="change-me-to-a-long-random-password"
ADMIN_NAME="System Administrator"

# Website cache refresh when products/prices change in the admin
WEBSITE_REVALIDATE_URL="http://localhost:3000/api/revalidate"
REVALIDATE_SECRET="generate-a-long-random-string"

# Optional commerce overrides
FREE_SHIPPING_THRESHOLD=2000
SHIPPING_FEE=150
