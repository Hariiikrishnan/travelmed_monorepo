PORT=5000

# PostgreSQL Connection URL
# Replace username, password, localhost, port, and database_name with your values
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travelmed?schema=public"

# JWT Secret for Admin Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Frontend Origin for CORS configuration
FRONTEND_URL="http://localhost:3000"

# Razorpay Payment Gateway Credentials
# Replace "dummy" with your real Razorpay Key ID and Secret in production
RAZORPAY_KEY_ID="dummy"
RAZORPAY_KEY_SECRET="dummy"

